# Sanity (public: safe in the client bundle; the dataset is read-only public)
PUBLIC_SANITY_PROJECT_ID=xsttrmdn
PUBLIC_SANITY_DATASET=production
# Set to 1 to build with the bundled sample content instead of Sanity
PUBLIC_SANITY_SAMPLE=0

# Only needed for scripts/seed-sanity.mjs (Editor token from sanity.io/manage). Never commit.
SANITY_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Git remote (not an env var, just a reminder)
# origin is git@github-personal:kriashks/personal-website.git, an SSH alias in
# ~/.ssh/config that uses ~/.ssh/id_ed25519_github_personal. Pushing fails with
# "Permission denied (publickey)" until this public key is registered on the
# kriashks GitHub account at https://github.com/settings/ssh/new :
#   ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINaQtaF3FUWlkW+P45MxxK2xHw0jxfp2uE+1NxW3azeC kriashks@gmail.com
# Test with: ssh -T git@github-personal
# The gh CLI is logged in as the work account and has read-only access here, so
# HTTPS pushes do not work either unless you `gh auth login` as kriashks.
# ---------------------------------------------------------------------------
